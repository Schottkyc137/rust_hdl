# Trivia and literal shapes
lit_comment="-- \x0a"
lit_block_comment="/* */"
lit_string="\"abc\""
lit_string_escaped_quote="\"a\"\"b\""
lit_char="'a'"
lit_integer="42"
lit_underscore_integer="1_000"
lit_real="1.0"
lit_exponent="1e10"
lit_neg_exponent="1.0e-3"
lit_based_2="2#1010#"
lit_based_16="16#ff#"
lit_based_exp="16#f#e2"
lit_bitstring_b="b\"1010\""
lit_bitstring_x="x\"ff\""
lit_bitstring_o="o\"77\""
lit_bitstring_d="d\"99\""
lit_bitstring_ub="ub\"1\""
lit_bitstring_sx="sx\"f\""
lit_bitstring_sized="8x\"ff\""
lit_extended_ident="\\ext id\\"
lit_extended_ident_escape="\\a\\\\b\\"
lit_physical="10 ns"
lit_latin1_high="\xe4"

# Common multi-token fragments
frag_entity_is="entity e is"
frag_end_entity="end entity;"
frag_architecture="architecture a of e is"
frag_begin_end="begin end;"
frag_package="package p is"
frag_package_body="package body p is"
frag_new_package="package p is new q generic map (g => 1);"
frag_context="context c is"
frag_configuration="configuration c of e is"
frag_library="library ieee;"
frag_use_all="use ieee.std_logic_1164.all;"
frag_context_ref="context work.c;"
frag_generic_clause="generic (g : integer := 0);"
frag_port_clause="port (p : in bit);"
frag_generic_map="generic map (g => 1)"
frag_port_map="port map (p => q)"
frag_signal_decl="signal s : std_logic;"
frag_constant_decl="constant c : integer := 0;"
frag_variable_decl="variable v : integer;"
frag_shared_variable="shared variable v : t;"
frag_file_decl="file f : text open read_mode is \"n\";"
frag_alias="alias a is b;"
frag_attr_decl="attribute a : string;"
frag_attr_spec="attribute a of b : signal is \"c\";"
frag_subtype="subtype s is integer range 0 to 7;"
frag_type_enum="type t is (a, b);"
frag_type_array="type t is array (natural range <>) of bit;"
frag_type_record="type t is record f : bit; end record;"
frag_type_access="type t is access integer;"
frag_type_file="type t is file of character;"
frag_type_protected="type t is protected end protected;"
frag_type_protected_body="type t is protected body end protected body;"
frag_type_physical="type t is range 0 to 1 units u; end units;"
frag_type_incomplete="type t;"
frag_range_downto="range 7 downto 0"
frag_range_to="range 0 to 7"
frag_range_attr="'range"
frag_subtype_indication="std_logic_vector(7 downto 0)"
frag_others_agg="(others => '0')"
frag_qualified="t'(1)"
frag_type_conv="integer(x)"
frag_function="function f return integer is"
frag_function_decl="function f (x : integer) return integer;"
frag_impure_function="impure function f return t is"
frag_procedure="procedure p (signal s : out bit) is"
frag_end_function="end function;"
frag_end_procedure="end procedure;"
frag_return="return 0;"
frag_process="process (clk) begin end process;"
frag_process_all="process (all) is"
frag_postponed_process="postponed process is"
frag_wait="wait until clk = '1';"
frag_wait_for="wait for 10 ns;"
frag_wait_on="wait on a, b;"
frag_if="if c then elsif d then else end if;"
frag_case="case x is when others => null; end case;"
frag_case_question="case? x is when others => null; end case?;"
frag_for_loop="for i in 0 to 3 loop end loop;"
frag_while_loop="while c loop end loop;"
frag_bare_loop="loop end loop;"
frag_next="next when c;"
frag_exit="exit when c;"
frag_assert="assert c report \"m\" severity error;"
frag_report="report \"m\";"
frag_null="null;"
frag_sig_assign="a <= b;"
frag_var_assign="a := b;"
frag_after="a <= b after 1 ns;"
frag_transport="a <= transport b;"
frag_reject="a <= reject 1 ns inertial b;"
frag_guarded_assign="a <= guarded b;"
frag_force="a <= force b;"
frag_release="a <= release;"
frag_cond_assign="a <= b when c else d;"
frag_selected_assign="with x select a <= b when others;"
frag_selected_force="with x select? a <= b when others;"
frag_block="b : block is begin end block;"
frag_block_guard="b : block (g) is"
frag_for_generate="g : for i in 0 to 3 generate end generate;"
frag_if_generate="g : if c generate else generate end generate;"
frag_case_generate="g : case x generate when others => end generate;"
frag_component_inst="i : c port map (a => b);"
frag_entity_inst="i : entity work.e(rtl) port map (a => b);"
frag_component_decl="component c is end component;"
frag_config_spec="for all : c use entity work.e;"
frag_disconnect="disconnect s : t after 1 ns;"
frag_group_template="group g is (label, signal);"
frag_group_decl="group g : t (a, b);"
frag_external_name="<< signal .a.b : bit >>"
frag_interface_view="p : view v of t"
frag_mode_view_decl="view v of t is end view;"
frag_psl_default_clock="default clock is rising_edge(clk);"
frag_ident_a="a"
frag_ident_b="b"
frag_label="l : "
frag_end_named="end l;"
